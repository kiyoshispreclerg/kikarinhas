msgstr "dono"

#: config/main.c:167
msgid "automatic"
msgstr "automático"

#: config/main.c:310
msgid "Invalid command name: use a single word, no spaces."
msgstr "Nome de comando inválido: use uma palavra só, sem espaços."

#: config/main.c:316
#, c-format
msgid "A command !%s already exists."
msgstr "Já existe um comando !%s."

#: config/main.c:327
#, c-format
msgid "Invalid cooldown: \"%s\" (seconds, 0 to 86400)."
msgstr "Espera inválida: \"%s\" (segundos, de 0 a 86400)."

#: config/main.c:410
msgid "new"
msgstr "novo"

#: config/main.c:426
msgid ""
"New command: give it a name, pick the action and, for \"sound\", the sound "
"in \"Data\"."
msgstr ""
"Comando novo: dê um nome, escolha a ação e, para \"sound\", o som em "
"\"Dado\"."

#: config/main.c:435 config/main.c:453
msgid "Pick a command in the list."
msgstr "Escolha um comando na lista."

#: config/main.c:441
msgid "Default commands cannot be removed: untick \"Active\" to turn one off."
msgstr "Comandos padrão não são removidos: desmarque \"Ativo\" para desligar."

#: config/main.c:461
msgid "Only default commands have default values."
msgstr "Só comandos padrão têm valores padrão."

#: config/main.c:479
msgid "Shortcut \"!name\" for an avatar, accessory or palette;"
msgstr "Atalho \"!nome\" para avatar, acessório ou paleta;"

#: config/main.c:483
msgid "cooldown"
msgstr "espera"

#: config/main.c:489
msgid "Help bubble (!help), even with message bubbles off;"
msgstr "Balão de ajuda (!ajuda), mesmo com os balões de mensagem desligados;"

#: config/main.c:494
msgid "random commands per bubble"
msgstr "comandos aleatórios por balão"

#: config/main.c:497
msgid "staying"
msgstr "fica"

#: config/main.c:523
msgid "Active"
msgstr "Ativo"

#: config/main.c:524 config/sounds.c:618
msgid "Command"
msgstr "Comando"

#: config/main.c:525
msgid "Action"
msgstr "Ação"

#: config/main.c:526
msgid "Data"
msgstr "Dado"

#: config/main.c:527 config/sounds.c:619
msgid "Aliases"
msgstr "Apelidos"

#: config/main.c:528
msgid "Cooldown (s)"
msgstr "Espera (s)"

#: config/main.c:529
msgid "Global (s)"
msgstr "Para todos (s)"

#: config/main.c:533
msgid "Who can"
msgstr "Quem pode"

#: config/main.c:544
msgid ""
"<small>Double-click a cell to edit it. Aliases separated by commas. \"Data\" "
"is the command's fixed argument (the sound of a !horn, the avatar of a !"
"pika); empty, whatever the person typed is used. The channel owner never "
"waits. \"Who can\" is the lowest level allowed: anyone, members, trusted "
"(marked in the Viewers tab), moderators, owner.</small>"
msgstr ""
"<small>Clique duas vezes numa célula para editar. Apelidos separados por "
"vírgula. \"Dado\" é o argumento fixo do comando (o som de um !buzina, o "
"avatar de um !pika); vazio, vale o que a pessoa digitou. O dono do canal "
"nunca espera. \"Quem pode\" é o nível mínimo: qualquer um, membros, "
"confiáveis (marcados na aba Espectadores), moderadores, dono.</small>"

#: config/main.c:557 config/sounds.c:431 config/sources.c:68
