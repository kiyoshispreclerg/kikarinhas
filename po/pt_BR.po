msgstr "%s agora é %s (gravado no arquivo; vale na próxima vez)."

#: config/audience.c:303
msgid "Could not write the people file."
msgstr "Não consegui gravar o arquivo de pessoas."

#: config/audience.c:323
msgid "Search"
msgstr "Procurar"

#: config/audience.c:329
msgid "_Refresh"
msgstr "A_tualizar"

#: config/audience.c:353
msgid "Name"
msgstr "Nome"

