#: config/main.c:514
#, c-format
msgid "Kikarinhas v%s — settings"
msgstr "Kikarinhas v%s — configuração"

#: config/main.c:529
msgid "Window"
msgstr "Janela"

#: config/main.c:534
msgid "Mode"
msgstr "Modo"

#: config/main.c:535
msgid ""
"obs: ordinary window for OBS's Window Capture (Xcomposite). desktop: over "
"the desktop, clicks go through."
msgstr ""
"obs: janela comum para a Captura de janela (Xcomposite) do OBS. desktop: por "
"cima da área de trabalho, o clique atravessa."

#: config/main.c:545 config/wall.c:71
msgid "Size"
msgstr "Tamanho"

#: config/main.c:545
msgid "Only in obs mode."
msgstr "Só no modo obs."

#: config/main.c:546
msgid "Frames per second"
msgstr "Quadros por segundo"

#: config/main.c:549
msgid "Avatars"
msgstr "Avatares"

#: config/main.c:550
msgid "Scale"
msgstr "Escala"

#: config/main.c:552
msgid "Ground"
msgstr "Chão"

#: config/main.c:553
msgid ""
"Pixels between the feet and the bottom edge; automatic leaves room for the "
"name."
msgstr ""
"Pixels entre os pés e a borda de baixo; automático deixa espaço para o nome."

#: config/main.c:554
msgid "Random"
msgstr "Sorteados"

#: config/main.c:555
msgid ""
"Avatars that walk around without belonging to anyone in the chat; automatic: "
"6 without chat, 0 with chat."
msgstr ""
"Avatares que andam sem ser de ninguém do chat; automático: 6 sem chat, 0 com "
"chat."

#: config/main.c:556
msgid "Always on screen"
msgstr "Sempre na tela"

#: config/main.c:557
msgid "Avatar names separated by commas."
msgstr "Nomes de avatares separados por vírgula."

#: config/main.c:561
msgid "Everyone's avatar"
msgstr "Avatar de todos"

#: config/main.c:562
msgid "Empty: a random one per person, always the same."
msgstr "Vazio: um sorteado por pessoa, sempre o mesmo."

#: config/main.c:563
msgid "Stream Avatars folder"
msgstr "Pasta do Stream Avatars"

#: config/main.c:565
msgid ""
"The \"data\" folder; empty: searches the Steam libraries; off: don't use "
"Stream Avatars."
msgstr ""
"A pasta \"data\"; vazio: procura nas bibliotecas do Steam; off: não usa o "
"Stream Avatars."

#: config/main.c:567
msgid "More avatar folders"
msgstr "Outras pastas de avatares"

#: config/main.c:568
msgid ""
"Each one may hold a data folder (streamavatars_json.txt), a pack (data.txt) "
"or folders of those. Your own folder is read first, then these, then Stream "
"Avatars; on a repeated name the first one wins. Only changes when kikarinhas "
"restarts."
msgstr ""
"Cada uma pode ter uma pasta de dados (streamavatars_json.txt), um pacote "
"(data.txt) ou pastas com eles. A sua pasta é lida primeiro, depois estas, "
"depois o Stream Avatars; com nome repetido, vale o primeiro. Só muda "
"reiniciando o kikarinhas."

#: config/main.c:574
msgid "below"
msgstr "embaixo"

#: config/main.c:575
msgid "above"
msgstr "em cima"

#: config/main.c:577
msgid "Avatar name"
msgstr "Nome do avatar"

#: config/main.c:578
msgid "Show names"
msgstr "Mostrar nomes"

#: config/main.c:579
msgid "Above or below the avatar."
msgstr "Em cima ou embaixo do avatar."

#: config/main.c:584 config/wall.c:69 config/wall.c:80 config/danmaku.c:79
#: config/commands.c:563 config/points.c:78
msgid "seconds"
msgstr "segundos"

#: config/main.c:586
msgid "Hide the name after inactivity of"
msgstr "Esconder o nome após inatividade de"

#: config/main.c:588
msgid ""
"The name shows on arrival, on a message or command and while a bubble is up; "
"after this quiet time only the drawing stays. Independent of the time until "
"the avatar leaves."
msgstr ""
"O nome aparece na chegada, numa mensagem ou comando e enquanto há um balão; "
"depois desse tempo em silêncio fica só o desenho. É independente do tempo "
"até o avatar sair da tela."

#: config/main.c:591 config/timers.c:331
msgid "Messages"
msgstr "Mensagens"

#: config/main.c:592
msgid "Show a speech bubble with the message"
msgstr "Mostrar balão com a mensagem"

#: config/main.c:593
msgid "With danmaku on (its own tab), messages fly across instead."
msgstr ""
"Com o danmaku ligado (aba própria), as mensagens atravessam a tela no lugar "
"do balão."

#: config/main.c:595
msgid "Message bubble stays"
msgstr "Balão de mensagem fica"

#: config/main.c:598
msgid "Seconds on screen; automatic: 4 to 12 s, by the length of the text."
msgstr ""
"Segundos na tela; automático: de 4 a 12 s, conforme o tamanho do texto."

#: config/main.c:603
msgid "Name font"
msgstr "Fonte do nome"

#: config/main.c:604
msgid ""
"Pango family and style (e.g. Sans Bold) and size in points; empty: Sans "
"Bold. Only changes when kikarinhas restarts."
msgstr ""
"Família e estilo do Pango (ex.: Sans Bold) e tamanho em pontos; vazio: Sans "
"Bold. Só muda reiniciando o kikarinhas."

#: config/main.c:609
msgid "Bubble font"
msgstr "Fonte do balão"

#: config/main.c:610
msgid "Empty: Sans. Applies to the next bubbles."
msgstr "Vazio: Sans. Vale para os próximos balões."

#: config/main.c:612
msgid "Chat"
msgstr "Chat"

#: config/main.c:613
msgid "Lives"
msgstr "Lives"

#: config/main.c:614
msgid ""
"Every live in the list is read at the same time, YouTube and Twitch "
"together. Double-click a link to edit it."
msgstr ""
"Todas as lives da lista são lidas ao mesmo tempo, YouTube e Twitch juntos. "
"Clique duas vezes num link para editar."

#: config/main.c:617
msgid "BTTV, FFZ and 7TV emotes on Twitch, 7TV on Kick"
msgstr "Emotes do BTTV, FFZ e 7TV na Twitch e do 7TV no Kick"

#: config/main.c:618
msgid ""
"Downloads the global lists and the channel's, so those emotes also fly on "
"the emote wall."
msgstr ""
"Baixa as listas globais e as do canal, para esses emotes também voarem no "
"emote wall."

#: config/main.c:620
msgid "Fake chat (to test without a stream)"
msgstr "Chat de mentira (para testar sem live)"

#: config/main.c:621
msgid "Avatars at the same time"
msgstr "Avatares ao mesmo tempo"

#: config/main.c:623
msgid "Leaves after"
msgstr "Some depois de"

#: config/main.c:624
msgid "Seconds of silence until the avatar leaves."
msgstr "Segundos em silêncio até o avatar sair."

#: config/main.c:626
msgid "Print the messages in the terminal"
msgstr "Mostrar as mensagens no terminal"

#: config/main.c:627
msgid "People file"
msgstr "Arquivo de pessoas"

#: config/main.c:628
msgid ""
"Avatar, color and accessories of each person; empty: ~/.local/share/"
"kikarinhas/users.tsv."
msgstr ""
"Avatar, cor e acessórios de cada um; vazio: ~/.local/share/kikarinhas/users."
"tsv."

#: config/main.c:630
msgid "Control socket"
msgstr "Socket de controle"

#: config/main.c:632
msgid "For bridges and the Apply button; empty: the default; off: disabled."
msgstr "Para bridges e para o botão Aplicar; vazio: o padrão; off: desligado."

#: config/main.c:636
msgid "Installed avatars"
msgstr "Avatares instalados"

#: config/main.c:638 config/points.c:114
msgid "Commands"
msgstr "Comandos"

#: config/main.c:640 config/points.c:116
msgid "Sounds"
msgstr "Sons"

#: config/main.c:642
msgid "Emote wall"
msgstr "Emote wall"

#: config/main.c:644
msgid "Danmaku"
msgstr "Danmaku"

#: config/main.c:646 config/audience.c:471
msgid "Points"
msgstr "Pontos"

#: config/main.c:648
msgid "Timers"
msgstr "Timers"

#: config/main.c:650
msgid "Viewers"
msgstr "Espectadores"

#: config/main.c:669
msgid "_Close"
msgstr "_Fechar"

#: config/main.c:670
msgid "_Save"
msgstr "_Salvar"

#: config/main.c:671
msgid "Save and _apply"
msgstr "Salvar e _aplicar"

#: config/main.c:715
#, c-format
msgid ""
"Usage: kikarinhas-config [FILE]\n"
"       kikarinhas-config -V, --version\n"
"Edits ~/.config/kikarinhas/kikarinhas.ini (or FILE).\n"
msgstr ""
"Uso: kikarinhas-config [ARQUIVO]\n"
"      kikarinhas-config -V, --version\n"
"Edita ~/.config/kikarinhas/kikarinhas.ini (ou ARQUIVO).\n"

#: config/main.c:723
#, c-format
msgid "kikarinhas-config: no $HOME\n"
msgstr "kikarinhas-config: sem $HOME\n"

#: config/main.c:730
#, c-format
msgid "kikarinhas-config: could not read %s: %s\n"
msgstr "kikarinhas-config: não consegui ler %s: %s\n"

#: config/main.c:735
msgid ""
"# Kikarinhas: generated by kikarinhas-config. You may edit it by hand;\n"
"# comments are kept.\n"
msgstr ""
"# Kikarinhas: gerado pelo kikarinhas-config. Pode editar à mão;\n"
"# comentários são mantidos.\n"

#: config/main.c:744
#, c-format
msgid "kikarinhas-config: out of memory\n"
msgstr "kikarinhas-config: sem memória\n"

