#: config/audience.c:451
msgid ""
"Double-click the avatar to change it (you can type the name). With "
"kikarinhas running, the change takes effect at once. Empty avatar: a random "
"one, always the same. Level: what the chat badges said on the latest "
"message. Trusted: ticked by hand, for commands limited to trusted people and "
"up. People from Stream Avatars without a name or dates: run kikarinhas --"
"import-sa-users once."
msgstr ""
"Double-click the avatar to change it (you can type the name). With "
"kikarinhas running, the change takes effect at once. Empty avatar: a random "
"one, always the same. Level: what the chat badges said on the latest "
"message. Trusted: ticked by hand, for commands limited to trusted people and "
"up. People from Stream Avatars without a name or dates: run kikarinhas --"
"import-sa-users once."

#: config/sources.c:64
msgid "Add a live"
msgstr "Adicionar live"

#: config/sources.c:83 config/sources.c:169
msgid "Live or channel"
msgstr "Live ou canal"

#: config/sources.c:84
msgid ""
"YouTube: link to the stream or channel, @handle or video id; with a channel, "
"it waits for it to go live. Twitch: channel name or twitch.tv link (read "
"without logging in)."
msgstr ""
"YouTube: link da live ou do canal, @handle ou id do vídeo; com um canal, "
"espera ele entrar ao vivo. Twitch: nome do canal ou link twitch.tv (lido sem "
"login)."

#: config/sources.c:99
#, c-format
msgid "%s: %s added. Save and apply to connect."
msgstr "%s: %s adicionado. Salve e aplique para conectar."

#: config/sources.c:104
#, c-format
msgid ""
"Twitch: could not understand \"%s\" (use the channel name or the twitch.tv/"
"channel link)."
msgstr ""
"Twitch: não entendi \"%s\" (use o nome do canal ou o link twitch.tv/canal)."

#: config/sources.c:106
#, c-format
msgid ""
"YouTube: could not understand \"%s\" (use the link to the stream or channel, "
"or the @handle)."
msgstr ""
"YouTube: não entendi \"%s\" (use o link da live ou do canal, ou o @handle)."

#: config/sources.c:124
msgid "Pick a live in the list."
msgstr "Escolha uma live na lista."

#: config/sources.c:147
#, c-format
msgid "%s: could not understand \"%s\"."
msgstr "%s: não entendi \"%s\"."

